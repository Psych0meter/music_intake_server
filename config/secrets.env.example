# Copy to config/secrets.env (mode 600, owned by musicintake), fill in,
# then: systemctl restart music-recognize.service
#
# NOTE: as of migration 0011_add_settings, ACOUSTID_API_KEY,
# GENIUS_ACCESS_TOKEN, and SCAN_WORKERS below are no longer read by
# either service at all - the Settings page in the web UI (/settings)
# is authoritative for these three, backed by the database instead of
# this file. Fill them in there after upgrading (once), not here -
# values left here are ignored, not used as a seed. See "Settings
# (Settings page)" in docs/CONFIGURATION.md.

# Required for AcoustID/MusicBrainz lookups - free, register at:
# https://acoustid.org/my-applications
ACOUSTID_API_KEY=

# Optional - only used by the lyrics-transcription fallback (fires when
# SongRec and AcoustID both find nothing at all). Free, register at:
# https://genius.com/api-clients
# Requires `pip install faster-whisper` in the venv as well.
GENIUS_ACCESS_TOKEN=

# Optional - how many files to identify concurrently (SongRec/AcoustID/
# iTunes/Genius calls are mostly network wait, not CPU, so this is what
# actually uses the vCPUs you give the container). Defaults to
# min(8, cpu_count). Turn it down if you're hitting AcoustID/iTunes/
# Genius rate limits or saturating a network NAS mount; turn it up if
# you have spare cores and a fast local/NAS connection.
# See docs/CONFIGURATION.md.
SCAN_WORKERS=
